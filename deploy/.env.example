# Victus — environment for deploy/docker-compose.yml
# Copy to deploy/.env and fill in. Never commit deploy/.env.
#
# Nested settings use the pydantic-settings double-underscore delimiter:
#   VICTUS_<SECTION>__<KEY>  ==  section.key in victus.yaml

# ── Images & ports ──────────────────────────────────────────────────────────
VICTUS_VERSION=latest              # image tag (vX.Y.Z or latest)
API_PORT=8090                      # host port for api (bound to 127.0.0.1)
WEB_PORT=8091                      # host port for web (bound to 127.0.0.1)
TZ=Europe/Berlin

# ── Storage ─────────────────────────────────────────────────────────────────
# SQLite (default, WAL mode, foreign keys enforced on every connection):
VICTUS_DATABASE__URL=sqlite:////data/victus.db
# PostgreSQL (start with `--profile postgres`):
# VICTUS_DATABASE__URL=postgresql+psycopg://victus:${POSTGRES_PASSWORD}@postgres:5432/victus
VICTUS_STORAGE__PATH=/data/blobs   # attachments (audio, images), keyed by sha256
BACKUP_DIR=./backups                # host path bind-mounted into the backup service, e.g. a mounted HDD path

# ── Authentication (WebAuthn) ───────────────────────────────────────────────
# RP_ID must be fixed BEFORE the first passkey is registered. Changing it later
# invalidates every passkey. HTTPS is mandatory (exception: http://localhost).
VICTUS_AUTH__RP_ID=victus.example.com
VICTUS_AUTH__ORIGIN=https://victus.example.com
VICTUS_AUTH__SESSION_TTL_DAYS=30

# ── Providers ───────────────────────────────────────────────────────────────
VICTUS_PROVIDERS__OPENAI_API_KEY=      # transcription (gpt-4o-transcribe)
VICTUS_PROVIDERS__ANTHROPIC_API_KEY=   # agent worker (runner "worker"); leave empty to use only the external runner
VICTUS_TRANSCRIPTION__MODEL=gpt-4o-transcribe

# ── Agent worker ────────────────────────────────────────────────────────────
VICTUS_AGENT__ENABLED=false            # true once captures should be processed automatically
VICTUS_AGENT__CRON=0 * * * *           # hourly
VICTUS_AGENT__MODEL=claude-sonnet-5
VICTUS_AGENT__BUDGET__MAX_USD_PER_RUN=0.50

# ── MCP over Streamable HTTP ────────────────────────────────────────────────
VICTUS_MCP__HTTP_ENABLED=false         # stdio (`victus mcp`) always works; HTTP is opt-in
VICTUS_MCP__ALLOWED_CIDRS=100.64.0.0/10   # comma-separated; default = Tailscale CGNAT range

# ── Backup ──────────────────────────────────────────────────────────────────
VICTUS_BACKUP__CRON=0 3 * * *
VICTUS_BACKUP__RETENTION_DAILY=7
VICTUS_BACKUP__RETENTION_WEEKLY=8
VICTUS_BACKUP__RETENTION_MONTHLY=12

# ── Optional profiles ───────────────────────────────────────────────────────
POSTGRES_DB=victus
POSTGRES_USER=victus
POSTGRES_PASSWORD=                     # required with --profile postgres
CF_API_TOKEN=                          # required with --profile caddy; Cloudflare token scoped Zone→DNS→Edit for the zone only
VICTUS_DOMAIN=victus.example.com

# ── Logging ─────────────────────────────────────────────────────────────────
VICTUS_LOG_LEVEL=info                  # debug | info | warning | error
