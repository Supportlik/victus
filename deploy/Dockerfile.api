# Victus API / worker / backup image.
# Build context is the repository root:  docker build -f deploy/Dockerfile.api .
# The same image runs `victus serve`, `victus worker`, `victus backup …` and `victus mcp`.
#
# Base images are Alpine and pinned to the newest stable release; Dependabot
# (`.github/dependabot.yml`, ecosystem docker) proposes bumps.
#
# The tag is written out in both stages rather than held in an ARG: Dependabot cannot see
# through `FROM ${PYTHON_IMAGE}` and left this image unwatched, while it does update every
# occurrence of the same image in one pull request. Keep the two lines equal.

# ── Stage 1: resolve and install the locked dependency set ──────────────────
FROM python:3.14.7-alpine3.24 AS builder

# uv binary from its official image (always the latest release).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

# Build tools only for the rare dependency without a musllinux wheel.
RUN apk add --no-cache build-base libffi-dev

WORKDIR /app

# Dependencies first so the layer is cached until pyproject/uv.lock change.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project --extra postgres --extra auth --extra transcription --extra agent

# Then the project itself (schemas/ is force-included into the wheel).
COPY src ./src
COPY schemas ./schemas
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra postgres --extra auth --extra transcription --extra agent

# ── Stage 2: minimal Alpine runtime ─────────────────────────────────────────
FROM python:3.14.7-alpine3.24 AS runtime

ARG VERSION=dev
LABEL org.opencontainers.image.title="victus-api" \
      org.opencontainers.image.description="Victus — self-hosted nutrition tracking (API, worker, backup, MCP)" \
      org.opencontainers.image.source="https://github.com/Supportlik/victus" \
      org.opencontainers.image.licenses="LicenseRef-PolyForm-Noncommercial-1.0.0" \
      org.opencontainers.image.version="${VERSION}"

# ffmpeg: audio conversion for transcription (e.g. .oga → mp3).
# tini:   proper signal handling / zombie reaping for the scheduler processes.
# libffi/libstdc++: runtime libs for argon2 / pydantic-core wheels.
#
# `apk upgrade` runs first because a pinned base tag also freezes the package versions the
# tag was cut with. That is where the published image's seven util-linux findings came from:
# not the util-linux tools — the image ships none, this container mounts nothing — but the
# libuuid library that comes in with the list below, already patched in the same Alpine
# release. Without this line the fix would depend on the next base-image tag.
RUN apk --no-cache upgrade \
 && apk add --no-cache ffmpeg tini ca-certificates libffi libstdc++ \
 && addgroup -g 1000 -S victus \
 && adduser -u 1000 -S -G victus -h /home/victus -s /sbin/nologin victus \
 && mkdir -p /data /data/blobs /backups \
 && chown -R victus:victus /data /backups

# Everything runs out of /app/.venv, which uv builds without pip, so the interpreter's own
# pip and setuptools are never executed in this image — and they were the only reason the
# setuptools path traversal and the msgpack advisory (vendored inside pip) were reported
# against it. Nothing in the locked dependency set imports pkg_resources.
RUN rm -rf /usr/local/lib/python3*/ensurepip \
           /usr/local/lib/python3*/site-packages/pip* \
           /usr/local/lib/python3*/site-packages/setuptools* \
           /usr/local/lib/python3*/site-packages/pkg_resources* \
           /usr/local/lib/python3*/site-packages/_distutils_hack* \
           /usr/local/lib/python3*/site-packages/distutils-precedence.pth \
           /usr/local/bin/pip*

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VICTUS_DATABASE__URL=sqlite:////data/victus.db \
    VICTUS_STORAGE__PATH=/data/blobs

WORKDIR /app
COPY --from=builder --chown=victus:victus /app /app

USER victus
VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3).status == 200 else 1)" || exit 1

ENTRYPOINT ["/sbin/tini", "--", "victus"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000", "--migrate"]
