# Victus web image: Angular production build served by nginx.
# Build context is the repository root:  docker build -f deploy/Dockerfile.web .
#
# Base images are Alpine and pinned to the newest stable release; Dependabot
# (`.github/dependabot.yml`, ecosystem docker) proposes bumps.

# ── Stage 1: build the Angular bundle ───────────────────────────────────────
FROM node:26.12-alpine3.24 AS build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY web/ ./
RUN npm run build -- --configuration production

# ── Stage 2: nginx (unprivileged, Alpine, mainline) ─────────────────────────
FROM nginxinc/nginx-unprivileged:mainline-alpine3.24 AS runtime

ARG VERSION=dev
LABEL org.opencontainers.image.title="victus-web" \
      org.opencontainers.image.description="Victus — Angular web app served by nginx" \
      org.opencontainers.image.source="https://github.com/Supportlik/victus" \
      org.opencontainers.image.licenses="LicenseRef-PolyForm-Noncommercial-1.0.0" \
      org.opencontainers.image.version="${VERSION}"

# Same reason as in Dockerfile.api: the base tag freezes the Alpine packages it was cut with,
# and a fix Alpine has already shipped (zlib 1.3.2-r1 for CVE-2026-85091 at the time of
# writing) would otherwise wait for the next nginx tag. The upgrade needs root; the image
# drops back to `nginx` below.
USER root
RUN apk --no-cache upgrade

# The unprivileged image runs as user `nginx` and cannot bind port 80;
# nginx.conf therefore listens on 8080 and compose maps WEB_PORT → 8080.
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/web/browser /usr/share/nginx/html

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1
