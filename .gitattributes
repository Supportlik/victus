# Normalise line endings: everything text is LF in the repository and in the
# working tree, so shell scripts and Dockerfiles built on Windows still run on Linux.
* text=auto eol=lf

*.sh text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
