{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Supportlik/victus/schemas/agent-draft.schema.json",
  "title": "Victus agent draft",
  "description": "Structured output the agent produces for one day from captures (text, audio transcripts, images). Consumed by the CreateDraft use case; every line item stays a draft until approved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "date", "source_captures", "meals"],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumable_id", "name", "score", "tier"],
      "properties": {
        "consumable_id": { "type": "integer" },
        "name": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "tier": { "type": "integer", "enum": [1, 2, 3], "description": "Match tier: 1 exact incl. parentheses, 2 exact short form, 3 fuzzy" }
      }
    },
    "line_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "candidates", "chosen_consumable_id", "quantity", "unit_code", "estimated", "quantity_estimated", "confidence", "rationale", "source_kind", "source_capture_id"],
      "properties": {
        "raw_text": { "type": "string", "description": "What the user said/wrote/showed, verbatim." },
        "candidates": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/candidate" } },
        "chosen_consumable_id": { "type": ["integer", "null"], "description": "null = no product chosen; the item becomes a one-off consumable with the nutrition values below." },
        "one_off_nutrition_per_100": {
          "type": "object",
          "description": "Only when chosen_consumable_id is null.",
          "additionalProperties": false,
          "properties": {
            "kcal": { "type": "number", "minimum": 0 },
            "protein": { "type": "number", "minimum": 0 },
            "carbs": { "type": "number", "minimum": 0 },
            "fat": { "type": "number", "minimum": 0 },
            "fiber": { "type": "number", "minimum": 0 },
            "salt": { "type": ["number", "null"], "minimum": 0 },
            "source": { "type": "string" }
          }
        },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit_code": { "type": "string", "description": "Unit code from the unit table (g, ml, piece, cup, ...)." },
        "portion_label": { "type": ["string", "null"] },
        "base_quantity": { "type": ["number", "null"], "description": "Frozen amount in the product's base unit (g/ml) if the agent resolved it; otherwise the server resolves it via the portion table." },
        "estimated": { "type": "boolean", "description": "Nutrition values estimated (warning marker)." },
        "quantity_estimated": { "type": "boolean", "description": "Amount estimated (the riskier estimate)." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "maxLength": 500 },
        "source_kind": { "type": "string", "enum": ["transcript", "image", "text"] },
        "source_capture_id": { "type": "string" }
      }
    },
    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "line_items"],
      "properties": {
        "name": { "type": "string" },
        "time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "line_items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line_item" } }
      }
    }
  },
  "properties": {
    "run_id": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "source_captures": { "type": "array", "items": { "type": "string" }, "description": "Capture ids consumed for this day." },
    "meals": { "type": "array", "items": { "$ref": "#/$defs/meal" } },
    "training": { "type": ["string", "null"], "enum": ["rest", "strength", "martial_arts", null] },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "Short findings for the summary page (max 3–5)." },
    "open_questions": { "type": "array", "items": { "type": "string" }, "description": "Questions the user must answer before approval (e.g. 'Chips: how much?')." },
    "prompt_version": { "type": "string" }
  },
  "examples": [
    {
      "run_id": "run_01J7Z0000000000000000000A",
      "date": "2026-09-07",
      "source_captures": ["cap_01J7Z0000000000000000000B"],
      "meals": [
        {
          "name": "Dinner",
          "time": "19:30",
          "line_items": [
            {
              "raw_text": "a whole tub of skyr with berries",
              "candidates": [ { "consumable_id": 42, "name": "Skyr natural (400 g tub)", "score": 0.93, "tier": 2 } ],
              "chosen_consumable_id": 42,
              "quantity": 1, "unit_code": "cup", "portion_label": "whole tub", "base_quantity": 400,
              "estimated": false, "quantity_estimated": false, "confidence": 0.9,
              "rationale": "Tenant profile: skyr is always eaten as the whole 400 g tub.",
              "source_kind": "transcript", "source_capture_id": "cap_01J7Z0000000000000000000B"
            }
          ]
        }
      ],
      "training": "rest",
      "notes": ["Protein already at the optimum, fiber below minimum."],
      "open_questions": []
    }
  ]
}
